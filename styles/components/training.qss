/* Экран тренировки */

#page_ex {
    background: #111111;
}

#label_video {
    background: #111111;
    color: #8A97A6;
    border: none;
    padding: 0;
    margin: 0;
}

#btn_back_video {
    background-color: rgba(18, 20, 26, 165);
    border: 1px solid rgba(210, 220, 230, 55);
    border-radius: 20px;
    padding: 8px 18px;
    margin: 16px;
    color: #F4F7FA;
    min-width: 128px;
    min-height: 40px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

#btn_back_video:hover {
    background-color: rgba(29, 190, 183, 42);
    border: 1px solid rgba(29, 190, 183, 210);
    color: #ffffff;
}

#btn_back_video:pressed {
    background-color: rgba(29, 190, 183, 78);
    border: 1px solid #1dbeb7;
    color: #ffffff;
}
